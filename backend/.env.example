# Firebase Configuration
# Path to your Firebase Admin SDK service account JSON
# e.g., backend/credentials/serviceAccount.json
FIREBASE_CREDENTIALS_PATH=backend/credentials/serviceAccount.json

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/mumai_db

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Configuration
CORS_ORIGINS=http://localhost:8081,http://localhost:19000,http://localhost:19001,http://localhost:19002

# Security
SECRET_KEY=your_secret_key_here_change_in_production

# Application Settings
APP_ENV=development
DEBUG=True
